1"}, "karar_kodu": {"veri_hakem.py": "e88a30c38649da2c85b547e1431ae0549c984dc561d77ab380e5388874c588d2", "bozucu.py": "ef4de192c79f053ff92c9ba97aec99c4b0434a89f2ddfac088d3837eb942d4f9"}}, "kayit": {"figur": "Elsa", "yer": "dağ", "yan": ["Kristoff"], "sorun": "dağda tıkır tıkır garip bir ses geldi", "cozum": "dökülen küpleri gördü ve deliği buzla kapattı", "govde": "Bir sabah Elsa dağda, sarayının yanında yürüyordu. Birden yukarıdan tıkır tıkır garip bir ses geldi. Ses hiç durmadı ve Elsa merakla o yöne yürüdü. Orada Kristoff kızağına buz küpleri yüklüyordu. Kristoff çok hızlı çalışıyordu ve arkasına hiç bakmıyordu. Kızağın arkasında küçük bir delik vardı. Küpler bu delikten tek tek yere dökülüyordu. Küpler taşlara düşünce tıkır tıkır ses çıkarıyordu. Garip ses buradan geliyordu. Elsa hemen deliği ince bir buzla kapattı. Artık hiçbir küp dökülmedi ve ses de durdu. Kristoff dönünce küpleri topladı ve Elsa'ya teşekkür etti. Elsa çok sevindi, çünkü sesi bulmuş ve durdurmuştu."}}
{"sha1": "1b1a348490599561c6ebaf8e6c9c2a6765b9a0e1", "kimlik": "urun/hello_kitty#1b1a348490", "figur": "Hello Kitty", "yer": "park", "tohum": "hello_kitty-0007", "deneme": 2, "onarim": "87083a19da2adc17d8cffa3fbeaeb3682a6abe4f", "yamali": true, "fark": "--- once\n+++ sonra\n@@ -4 +4 @@\n-@degisim: çerçeve -> kenar\n+@degisim: çerçeve -> tabak\n@@ -6 +6 @@\n-Hello Kitty parkta annesiyle keyifli bir piknik yapıyordu. Oyunda Hello Kitty bir aşçıydı ve tabaktaki kurabiyeleri süslüyordu. Ama renkli şekeri yukarıdan saçtı ve rüzgar şekeri uçurdu. \"Şeker uçuyor, kızım!\" dedi annesi ve güldü. Hello Kitty tabağın yanına eğildi. Şekeri bu kez kurabiyelerin hemen üstüne yavaşça saçtı. Şeker uçmadı ve kurabiyelerin üstünde kaldı. Sonra kurabiyeleri tabağın kenarına yan yana dizdi. Tabak çok güzel oldu. Hello Kitty tabağı annesine verdi. \"Buyur, anneciğim, renkli kurabiyelerin hazır!\" dedi Hello Kitty.+Hello Kitty parkta annesiyle keyifli bir piknik yapıyordu. Hello Kitty yemek yapma oyunu oynuyordu ve kurabiyeleri süslüyordu. Ama renkli şekeri yukarıdan saçtı ve rüzgar şekeri uçurdu. \"Şeker uçuyor, kızım!\" dedi annesi ve güldü. Hello Kitty tabağın yanına eğildi. Şekeri bu kez kurabiyelerin hemen üstüne yavaşça saçtı. Şeker uçmadı ve kurabiyelerin üstünde kaldı. Sonra kurabiyeleri tabağın kenarına yan yana dizdi. Tabak çok güzel oldu. Hello Kitty tabağı annesine verdi. \"Buyur, anneciğim, renkli kurabiyelerin hazır!\" dedi Hello Kitty.\n", "degisim": ["çerçeve", "tabak"], "tohum_ozellikleri": {"tema": "taklit_hayal", "yan": ["annesi"], "diyalog": "var", "acilis": "figur_adi", "kapanis": "replik", "ozellik": "kurabiye"}, "kararlar": [{"mercek": "M", "parti": 55, "deneme": 1, "hakem": 1, "konum": 0, "rol": "hedef", "oy": "yok", "gecerli": true}, {"mercek": "M", "parti": 74, "deneme": 1, "hakem": 2, "konum": 0, "rol": "hedef", "oy": "yok", "gecerli": true}, {"mercek": "D", "parti": 50, "deneme": 1, "hakem": 1, "konum": 0, "rol": "hedef", "oy": "yok", "gecerli": true}, {"merce