_kelimeler.json": null, "data/zemberek_beyaz_liste.txt": null, "data/sade_sozluk.json": "0b253fbae0ed0b8c63e2b79f1fb00821793bd36da2f2def0a97a43788ceb5e5c", "data/sade_sozluk_sik.txt": "bd9a145f2ed4aed59306987fa3e139c6a33acfcd0a605530ac0aca5edb1df6b9", "data/urun_kartlari.json": "319a5af568c40cd6c8de893abd32d13564a8ec02fc764a2dfca4caef3e42faca", "data/urun_figurleri.json": "1fb109fb8c5e87c821e05a941f06ed29647da49daa384c52967dcf1cbef8f1d7", "data/karakterler.json": "367318e945cacf59fcbbd3831adf432e6ed66e195b824dc0537d583551b07e9d", "degerlendirme/HAKEM_M.md": "e0f7985c501b1563391053c14fb6ff793c799f61291ff9ca91c1892844e64d9c", "degerlendirme/HAKEM_D.md": "d6ed687cb86fc8d52517c072bb58e967fbb734ed4d6801afd90e6d5a79863cd5", "degerlendirme/HAKEM_K.md": "6cdc66b150efbb0d364c434d40b79815385d6f1fbc720560d07488942e51bbea"}, "serilestirme": "urun_kayit/1", "kartlar": {"niloya": "c1aa825bb76d5e5f1153724ac3f69e176847ad4c", "masa": "10deaad056b9f36760353594d5d9df55975158ad", "pepee": "05ab382dcfcbf5708d1792f4f6b67e73e41ec403", "keloglan": "a4de52dd6a51b6b0d0de5fc7f50713252729ea39", "doru": "1c126c4884a599465e632e3653578a4c07c48cfe", "hayri": "2a7f1a8c04dcd9822dee591d7d9d5b3a12c48a5b", "sakir": "6a55dc0adda2f0bbce6d756bb40293e12e0619eb", "elsa": "2675c7393c75e26b19adba8da00f04f4e7692607", "chase": "890a222fffb75a11644b7298d1f73bd1f9fbb13f", "orumcek_adam": "d18eef778e3dd8dd323ff56081908c8f3fc85265", "hello_kitty": "2685d7e20a5a7227e71370217a80bf56357abac7", "tosbi": "d337b0e28ea807dc75cac08d6ad1b7c248c44d6d", "tekir": "188922e8e612ca0a87467881ef607c46a021b48a", "pamuk": "16dad05d6cabd6be228d936515ba917ecce6a445", "karabas": "2ee9381a578576191fba62e8ca36a6f978151c8f"}, "tokenizer": {"k2": "6553611c609373e5da39d87a26d3a1048bfbcbf04a03f8c4eac74eb5a4c2a9ca", "sozluk": "6553611c609373e5da39d87a26d3a1048bfbcbf04a03f8c4eac74eb5a4c2a9ca"}, "sade_sozluk_icerik": "a3608353a9b39a9d2f7928d57c79978e32faf01afd7b72a50111ee11a78c525a", "zemberek": "0.2.3", "kok_yontemi": {"ad": "ek", "surum": "ek_soyma_1"}, "karar_kodu": {"veri_hakem.py": "e88a30c38649da2c85b547e1431ae0549c984dc561d77ab380e5388874c588d2", "bozucu.py": "ef4de192c79f053ff92c9ba97aec99c4b0434a89f2ddfac088d3837eb942d4f9"}}, "kayit": {"figur": "Maşa", "yer": "orman", "yan": ["Daşa"], "sorun": "iki kız aynı anda bağırdı ve birbirini duymadı", "cozum": "sırayla söyleme kuralı koydu", "govde": "Bir sabah Maşa ile Daşa ormanda çimenlere uzanmış, bulutlara bakıyordu. İkisi de bulutlarda şekil bulmak istiyordu. Ama ikisi aynı anda bağırıyordu ve birbirlerini duymuyorlardı. Maşa biraz düşündü ve yeni bir oyun kuralı denedi. \"Sırayla söyleyelim, Daşa, önce sen,\" dedi Maşa. Daşa gökyüzüne dikkatle baktı. \"Şu bulut bir kaşığa benziyor,\" dedi Daşa. Maşa da baktı ve kaşığı gördü. Sonra sıra Maşa'ya geldi. \"Şu bulut da kocaman bir elmaya benziyor!\" dedi Maşa. Daşa elmayı görünce sevinçli bir sesle güldü. İki kız sırayla bulutlara baktı ve oyunlarına mutlu mutlu devam etti."}}
{"sha1": "82fa6402e66b91f2b1cca6febfda751277bf7a8a", "kimlik": "urun/niloya#82fa6402e6", "figur": "Niloya", "yer": "orman", "tohum": "niloya-0008", "deneme": 1, "onarim": null, "yamali": true, "fark": "--- once\n+++ sonra\n@@ -2 +2 @@\n-@plan: ikisi aynı anda şarkı söyleyince kimse yürümedi | sırayla biri şarkı söyledi öbürü yürüdü\n+@plan: ikisi aynı anda şarkı söyledi ve oyun olmadı | sırayla oynamayı önerdi ve önce kendisi söyledi\n@@ -4 +4 @@\n-Bir sabah Niloya ile Mete ormanda bir oyun oynamak istedi. Oyunda biri şarkı söyleyecek, öbürü yürüyüp şarkı bitince duracaktı. Ama ikisi de aynı anda şarkı söylemeye başladı ve kimse yürümedi. \"Böyle olmaz ki!\" dedi Mete gülerek. \"Sırayla oynayalım, Mete, önce ben söyleyeyim,\" dedi Niloya. Niloya şarkısını söyledi, Mete de yoncaların üstünde sessiz adımlarla yürüdü. Şarkı bitince Mete hemen durdu ve hiç kıpırdamadı. Sonra Mete şarkı söyledi, Niloya yürüdü. Mete şarkıyı birden kesince Niloya tek ayağının üstünde kaldı. İkisi kahkahalarla güldü. Niloya çok mutluydu, çünkü sırayla oynayınca oyun çok eğlenceli olmuştu.+Bir sabah Niloya ile Mete ormanda dur oyunu oynamak istedi. Oyunda şarkı bitince yürüyen hemen duracaktı. Ama ikisi de aynı anda şarkı söylemeye başladı ve oyun başlamadı. \"Böyle olmaz ki!\" dedi Mete gülerek. \"Sırayla oynayalım, Mete, önce ben söyleyeyim,\" dedi Niloya. Niloya şarkı söyledi, Mete de yeşil yonca üstünde sessiz adımlarla yürüdü. Şarkı bitince Mete hemen durdu ve hiç kıpırdamadı. Sonra Mete şarkı söyledi, Niloya yürüdü. Mete şarkıyı birden kesince Niloya tek ayağının üstünde kaldı. İkisi kahkahalarla güldü. Niloya çok mutluydu, çünkü sırayla oynamak çok eğlenceliydi.\n", "degisim": null, "tohum_ozellikleri": {"tema": "sirayla_oynamak", "yan": ["Mete"], "diyalog": "var", "acilis": "zaman", "kapanis": "duygu", "ozellik": "şarkı"}, "kararlar": [{"mercek": "M", "parti": 19, "deneme": 1, "hakem": 1, "konum": 0, "rol": "hedef", "oy": "yok", "gecerli": true}, {"mercek": "M", "parti": 41, "deneme"