_1"}, "karar_kodu": {"veri_hakem.py": "e88a30c38649da2c85b547e1431ae0549c984dc561d77ab380e5388874c588d2", "bozucu.py": "ef4de192c79f053ff92c9ba97aec99c4b0434a89f2ddfac088d3837eb942d4f9"}}, "kayit": {"figur": "Chase", "yer": "dağ", "yan": ["Skye"], "sorun": "ağaçtan kar döküldü ve kurabiye kutusunun üstünü örttü", "cozum": "kutuyu kokusundan buldu ve kurabiyeleri paylaştı", "govde": "Güneş çıkmıştı ve ağaçlardan su damlıyordu. Chase karlı dağda kurabiyelerini Skye ile paylaşacaktı. Ama birden ağaçtan kar döküldü ve kurabiye kutusunun üstünü örttü. \"Kutu nerede?\" diye sordu Skye. Chase burnunu kara yaklaştırdı ve kokladı. Kurabiyelerin tatlı kokusunu hemen aldı. Patileriyle karı kazıdı ve kutuyu buldu. \"Ne akıllı bir köpeksin, Chase!\" dedi Skye. Chase kutuyu açtı; içinde altı kurabiye vardı. Chase üç kurabiyeyi Skye'a verdi. İkisi kurabiyelerini yan yana oturup yedi. Chase çok mutluydu, çünkü kurabiyelerini arkadaşıyla paylaşmıştı."}}
