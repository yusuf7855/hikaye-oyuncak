[
 {
  "id": "v4/tek_penguen_2#0",
  "puan": 9,
  "neden": "Porsuğun odunla ısınması (ateş) mantığı zayıf."
 },
 {
  "id": "v4/tek_penguen_2#1",
  "puan": 9,
  "neden": "Dereye atlayacakken köprüden geçmesi küçük mantık pürüzü."
 },
 {
  "id": "v4/tek_penguen_2#2",
  "puan": 8,
  "neden": "Paytak suçunu söylüyor ama özür dilemiyor; karda mantar sepeti tuhaf."
 },
 {
  "id": "v4/tek_penguen_2#3",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#4",
  "puan": 8,
  "neden": "'yuvası daha bitmedi' zaman hatası; kar fırtınasında Paytak'ın dışarıda neşeyle kayması mantıksız."
 },
 {
  "id": "v4/tek_penguen_2#5",
  "puan": 8,
  "neden": "Karlı gecede cırcır böceği tuhaf; 'ninniyi alçak sesle öttü' bozuk Türkçe."
 },
 {
  "id": "v4/tek_penguen_2#6",
  "puan": 9,
  "neden": "Anlatımda 'Dün akşam/Bugün' zaman karışıklığı."
 },
 {
  "id": "v4/tek_penguen_2#7",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#8",
  "puan": 9,
  "neden": "Fok denize girip serinleyebilirdi; gölge sorunu zayıf kurulmuş."
 },
 {
  "id": "v4/tek_penguen_2#9",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#10",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#11",
  "puan": 9,
  "neden": "Az önce tanıştığı balinaya 'arkadaşını' denmesi; balinanın cevabı soruyla tam örtüşmüyor."
 },
 {
  "id": "v4/tek_penguen_2#12",
  "puan": 8,
  "neden": "Ördeğe yüzme öğretmek karakter doğasına aykırı (ördekler doğuştan yüzer)."
 },
 {
  "id": "v4/tek_penguen_2#13",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#14",
  "puan": 9,
  "neden": "Yosunları göster denince renkli taşları göstermesi küçük uyumsuzluk."
 },
 {
  "id": "v4/tek_penguen_2#15",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#16",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#17",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#18",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#19",
  "puan": 9,
  "neden": "'Sıcak bir ev' ile hep açık pencere ayrıntısı hafif çelişkili/gereksiz."
 },
 {
  "id": "v4/tek_penguen_2#20",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#21",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#22",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#23",
  "puan": 9,
  "neden": "'Paytak paytak' isim-zarf tekrarı okurken karışık."
 },
 {
  "id": "v4/tek_penguen_2#24",
  "puan": 9,
  "neden": "'Kumdan buz dağları' tuhaf ifade."
 },
 {
  "id": "v4/tek_penguen_2#25",
  "puan": 9,
  "neden": "'Kuzunun ipine bağlı ... balonu vardı' belirsiz, bozuk cümle."
 },
 {
  "id": "v4/tek_penguen_2#26",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#27",
  "puan": 8,
  "neden": "Sorun yiyecekken 'temiz yer hazırlarım' diyor; tohumlar açıklamasız ortaya çıkıyor."
 },
 {
  "id": "v4/tek_penguen_2#28",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#29",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#30",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#31",
  "puan": 8,
  "neden": "'Paytak paytak paytak' tekrarı; 'parka yeni geldi' zaman hatası."
 },
 {
  "id": "v4/tek_penguen_2#32",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#33",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#34",
  "puan": 9,
  "neden": "Aşçı buz istiyor, Paytak kar getiriyor; küçük uyumsuzluk."
 },
 {
  "id": "v4/tek_penguen_2#35",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#36",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#37",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#38",
  "puan": 9,
  "neden": "'Ertesi gün ... doğum günüydü' açılışta zaman referansı bozuk."
 },
 {
  "id": "v4/tek_penguen_2#39",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#40",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#41",
  "puan": 8,
  "neden": "Kıskançlığı sebepsiz, aniden bırakıyor."
 },
 {
  "id": "v4/tek_penguen_2#42",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#43",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#44",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#45",
  "puan": 9,
  "neden": "'Rengarenk mavi çiçekler' çelişkili kelime seçimi."
 },
 {
  "id": "v4/tek_penguen_2#46",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_penguen_2#47",
  "puan": 9,
  "neden": "'Seslendi ... diye seslendi' tekrar."
 }
]