  "puan": 10,
  "neden": ""
 },
 {
  "id": "populer/elsa_2#21",
  "puan": 9,
  "neden": "Karı kendisi kaldırabilen Elsa'nın yolları açmak için Kristoff'un yardımına ihtiyaç duyması tutarsız."
 },
