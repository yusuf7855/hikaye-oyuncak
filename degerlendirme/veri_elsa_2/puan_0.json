[
 {
  "id": "populer/elsa_2#0",
  "puan": 9,
  "neden": "Anna hikâyede hiç konuşmuyor ve etkisiz; sorun (çocuğun çikolataya bakması) zayıf."
 },
 {
  "id": "populer/elsa_2#1",
  "puan": 8,
  "neden": "Eldivenler yalnız elleri korur, soğuk gövdeye sarılma sorununu tam çözmez; soğuk ve yalnızlık iki ayrı sorun."
 },
 {
  "id": "populer/elsa_2#2",
  "puan": 9,
  "neden": "Pencere zaten kapatılmışken fenerlerin gerekçesi zayıf; mumların nasıl yakıldığı belirsiz."
 },
 {
  "id": "populer/elsa_2#3",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "populer/elsa_2#4",
  "puan": 8,
  "neden": "Elsa sahnede olduğu söylenmeden bahçıvan ona soru soruyor; kime hitap ettiği belirsiz."
 },
 {
  "id": "populer/elsa_2#5",
  "puan": 9,
  "neden": "\"Özrünü kabul ediyorum\" repliği yapay ve didaktik."
 },
 {
  "id": "populer/elsa_2#6",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "populer/elsa_2#7",
  "puan": 9,
  "neden": "Kar altında kalan kitabın sayfalarının kuru kalması inandırıcı değil."
 },
