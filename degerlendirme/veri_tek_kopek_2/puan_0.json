[
 {
  "id": "v4/tek_kopek_2#0",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#1",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#2",
  "puan": 8,
  "neden": "Ördek yüzebilecekken dar kütükte yürüyor; \"sıra sendeydi\" ve sıra bekleme dersi olaya tam oturmuyor."
 },
 {
  "id": "v4/tek_kopek_2#3",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#4",
  "puan": 8,
  "neden": "\"Yanında kalırım\" diyen Karabaş hemen uzaktaki ağaca koşuyor; top birden ortaya çıkıyor."
 },
 {
  "id": "v4/tek_kopek_2#5",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#6",
  "puan": 8,
  "neden": "Papatyalar önce beyaz, sonra rengarenk deniyor; çelişki."
 },
 {
  "id": "v4/tek_kopek_2#7",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#8",
  "puan": 8,
  "neden": "Kumsalda \"hiç gölge yoktu\" deniyor ama şemsiyenin gölgesi var; çelişki."
 },
 {
  "id": "v4/tek_kopek_2#9",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#10",
  "puan": 8,
  "neden": "Islak resmi havluyla kurulamak mantıksız; havlunun kime ait olduğu belirsiz."
 },
 {
  "id": "v4/tek_kopek_2#11",
  "puan": 9,
  "neden": "Sorun/çözüm yok denecek kadar zayıf; son biraz yavan."
 },
 {
  "id": "v4/tek_kopek_2#12",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#13",
  "puan": 9,
  "neden": "Yunusun burnuyla suyu itmesinden top oyunu fikrinin çıkması zayıf bağlantı."
 },
 {
  "id": "v4/tek_kopek_2#14",
  "puan": 9,
  "neden": "\"Neden uyumadın?\" yerine \"uyuyamadın\" olmalı; fener ışığının odaya girmesi zayıf."
 },
 {
  "id": "v4/tek_kopek_2#15",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#16",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#17",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#18",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#19",
  "puan": 9,
  "neden": "Son cümlede çiçeklerin \"serinlemesi\" yanlış; çiçekler susamıştı."
 },
 {
  "id": "v4/tek_kopek_2#20",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#21",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#22",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#23",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#24",
  "puan": 8,
  "neden": "Zil yolda düştü denip parkta çimende bulunuyor; yerdeki zilin rüzgârla çalması mantıksız."
 },
 {
  "id": "v4/tek_kopek_2#25",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#26",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#27",
  "puan": 9,
  "neden": "Kumrunun \"su boşa akarsa çiçeklere su kalmaz\" gerekçesi zayıf."
 },
 {
  "id": "v4/tek_kopek_2#28",
  "puan": 9,
  "neden": "Kazın soğuk suda yüzdüğü için hastalanması hayvan için mantıksız bir sebep."
 },
 {
  "id": "v4/tek_kopek_2#29",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#30",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#31",
  "puan": 8,
  "neden": "Kurbağanın \"seni duymadım\" demesi anlamsız; \"bilmiyordum\" olmalı."
 },
 {
  "id": "v4/tek_kopek_2#32",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#33",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#34",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#35",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#36",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#37",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#38",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#39",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#40",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#41",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#42",
  "puan": 9,
  "neden": "Kayanın üstündeki kartalın \"burada kuru ve güvendeyiz\" demesi mantıksız."
 },
 {
  "id": "v4/tek_kopek_2#43",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#44",
  "puan": 10,
  "neden": ""
 },
 {
  "id": "v4/tek_kopek_2#45",
  "puan": 9,
  "neden": "Tayın \"sen topu benden iyi yakalıyorsun\" sözü hikâyede gösterilmemiş."
 },
 {
  "id": "v4/tek_kopek_2#46",
  "puan": 7,
  "neden": "\"Annesi\" hiç tanıtılmadan konuşuyor; kimin annesi olduğu belirsiz."
 },
 {
  "id": "v4/tek_kopek_2#47",
  "puan": 10,
  "neden": ""
 }
]