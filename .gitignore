# python
__pycache__/
.venv/
*.pyc
*.egg-info/

# private training and evaluation data
/data/*
!/data/karakterler.json
!/data/oyuncak_hikayeleri/
!/data/oyuncak_v2/
!/data/oyuncak_v3/
!/data/oyuncak_v4/
